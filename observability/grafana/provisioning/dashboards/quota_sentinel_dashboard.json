      "title": "Rejections: 429 Throttled Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1
          },
          "color": { "mode": "palette-classic" },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(quota_sentinel_throttled_total[10s]))",
